{% extends "./base.njk" %}

<!-- Custom Styles -->
{% block styles %}
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        montserrat: [
                            'Montserrat', 'sans-serif'
                        ],
                        lato: ['Lato', 'sans-serif']
                    },
                    backgroundImage: {
                        'primary-gradient': 'linear-gradient(135deg, #f59e0b 0%, #d97706 50%, #f59e0b 100%)',
                        'secondary-gradient': 'linear-gradient(135deg, #1e3a8a 0%, #1e40af 100%)'
                    },
                    animation: {
                        'fade-in': 'fadeIn 0.6s ease-out forwards',
                        'count-up': 'countUp 1s ease-out forwards'
                    },
                    keyframes: {
                        fadeIn: {
                            'from': {
                                opacity: '0'
                            },
                            'to': {
                                opacity: '1'
                            }
                        },
                        countUp: {
                            'from': {
                                transform: 'translateY(20px)',
                                opacity: '0'
                            },
                            'to': {
                                transform: 'translateY(0)',
                                opacity: '1'
                            }
                        }
                    }
                }
            }
        }
    </script>
    <style type="text/tailwindcss">
        @layer utilities {
            .gradient-text {
                @apply bg-primary-gradient bg-clip-text text-transparent;
            }
            .gradient-underline {
                @apply relative inline-block;
            }
            .gradient-underline::after {
                @apply content-[''] absolute bottom-[-4px] left-0 w-full h-[3px] bg-primary-gradient scale-x-0 origin-right transition-transform duration-300 ease-in-out;
            }
            .gradient-underline:hover::after {
                @apply scale-x-100 origin-left;
            }
            .card-hover {
                @apply transition-all duration-300 ease-[cubic-bezier(0.25,0.8,0.25,1)];
            }
            .card-hover:hover {
                @apply -translate-y-[5px] shadow-lg;
            }
            .btn-micro {
                @apply transition-all duration-200 ease-in-out;
            }
            .btn-micro:hover {
                @apply -translate-y-[2px];
            }
            .btn-micro:active {
                @apply translate-y-[1px];
            }
            .post-tag {
                @apply transition-all duration-200 ease-in-out;
            }
            .post-tag:hover {
                @apply scale-[1.05];
            }
            .hover-scale {
                @apply transition-transform duration-300 ease-in-out;
            }
            .hover-scale:hover {
                @apply scale-[1.03];
            }
            .article-content p {
                @apply mb-5 leading-relaxed;
            }
            .article-content h2 {
                @apply font-montserrat font-bold mt-10 mb-5 text-[1.75rem] bg-primary-gradient bg-clip-text text-transparent;
            }
            .article-content h3 {
                @apply font-montserrat font-bold mt-8 mb-4 text-[1.5rem] text-blue-800;
            }
            .article-content ul {
                @apply list-disc pl-8 mb-0;
            }
            .article-content li {
                @apply mb-0;
            }
            .article-content blockquote {
                @apply border-l-4 border-amber-500 pl-6 my-8 italic text-gray-600;
            }
            .article-content img {
                @apply rounded-lg my-8 mx-auto max-w-full h-auto;
            }
        }
    </style>
{% endblock %}

{% block content %}
    <main class="py-12 bg-white">
        <div class="container mx-auto px-6 max-w-4xl">
            <!-- Article Header -->
            <header class="mb-12">
                <div class="flex flex-wrap gap-2 mb-4">
                    <a href="/article/category/selling-tips" class="bg-gray-100 hover:bg-gray-200 text-gray-800 text-xs font-bold px-3 py-1 rounded-full transition-colors post-tag">Selling Tips</a>
                    <a href="/article/category/home-improvement" class="bg-gray-100 hover:bg-gray-200 text-gray-800 text-xs font-bold px-3 py-1 rounded-full transition-colors post-tag">Home Improvement</a>
                    <span class="bg-amber-500 text-white text-xs font-bold px-3 py-1 rounded-full">New</span>
                </div>
                <h1 class="text-3xl md:text-4xl font-bold font-montserrat mb-4">{{ article.title }}</h1>
                <div class="flex items-center text-gray-600 mb-6">
                    <div class="flex items-center mr-6">
                        <i class="far fa-calendar-alt mr-2"></i>
                        <span>May 10, 2023</span>
                    </div>
                    <div class="flex items-center">
                        <i class="far fa-clock mr-2"></i>
                        <span>5 min read</span>
                    </div>
                </div>
                <div class="relative rounded-xl overflow-hidden mb-8">
                    <img src="{{article.thumbnail}}" alt="Home staging" class="w-full h-96 object-cover">
                    <div class="absolute bottom-0 left-0 right-0 h-3/5 bg-gradient-to-t from-black/80 to-transparent"></div>
                </div>
            </header>

            <!-- Article Body -->
            <article class="article-content md:text-lg text-md">
                {{article.content | safe}}
            </article>

