<section id="services" class="bg-white py-16 relative" style="scroll-margin-top: 90px;">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-12">
      <span class="text-amber-600 font-semibold text-sm mb-2 inline-block">WE PROVIDE COMPLETE SOLUTIONS</span>
      <h2 class="text-3xl font-bold text-gray-900 mb-3">We Handle Every Situation</h2>
      <p class="text-gray-600 max-w-2xl mx-auto text-sm">Just like we've helped hundreds home owners, we can solve your unique housing challenge.</p>
    </div>

    <!-- Services Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {% if service_limit %}
        {% for service in services.slice(0, service_limit) %}
          <div class="bg-gray-50 p-6 rounded-lg shadow-sm border-l-4 border-amber-500 hover:shadow-md transition-shadow">
            <div class="flex items-center mb-4">
              <div class="bg-amber-500 w-12 h-12 rounded-full flex items-center justify-center text-white text-xl mr-4">
                <i class="fas fa-file-invoice-dollar"></i>
              </div>
              <h3 class="text-xl font-bold text-gray-800">{{ service.title }}</h3>
            </div>
            <p class="text-gray-600 text-sm mb-3">{{ service.description }}</p>
            {# <ul class="space-y-2">
              <li class="flex items-start text-sm text-gray-600">
                <svg class="w-4 h-4 text-amber-500 mr-2 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
            Stop tax sale proceedings
          </li>
              <li class="flex items-start text-sm text-gray-600">
                <svg class="w-4 h-4 text-amber-500 mr-2 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
