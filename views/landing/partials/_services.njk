<section id="services" class="service-section" style="scroll-margin-top: 80px;">
  <div class="container mx-auto px-8">
    <h2 class="title">We Provide Solutions for Every Scenario!</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {% if service_limit %}
        {% for service in services.slice(0, service_limit) %}
          <!-- Accordion Item -->
          <div class="service-card">
            <button class="w-full text-left flex justify-between items-center focus:outline-none">
              <div class="flex items-center">
                <div class="w-10 h-10 bg-gradient-to-{{ 'b' if loop.index0 is even else 't' }} from-amber-400 via-yellow-500 to-amber-600 rounded-full flex items-center justify-center mr-4">
                  <i class="fas fa-file-invoice-dollar text-white text-xl"></i>
                </div>
                <h3 class="text-lg font-bold">{{ service.title }}</h3>
              </div>
            </button>
            <div class="mt-4 flex flex-col items-center">
              <p class="">{{ service.description }}</p>
            </div>
          </div>
        {% endfor %}
        <div class="flex col-span-full justify-center">
          <a href="/services" class="text-amber-800 mx-auto hover:underline mt-8 mb-14 inline-block">See More Services →</a>
        </div>
      {% else %}
        {% for service in services.slice(0, service_limit.length) %}
          <!-- Accordion Item -->
          <div class="service-card">
            <button class="w-full text-left flex justify-between items-center focus:outline-none">
              <div class="flex items-center">
                <div class="w-10 h-10 bg-gradient-to-{{ 'b' if loop.index0 is even else 't' }} from-amber-400 via-yellow-500 to-amber-600 rounded-full flex items-center justify-center mr-4">
                  <i class="fas fa-file-invoice-dollar text-white text-xl"></i>
                </div>
                <h3 class="text-lg font-bold">{{ service.title }}</h3>
              </div>
            </button>
            <div class="mt-4 flex flex-col items-center">
              <p class="">{{ service.description }}</p>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>

    {% if isLimited %}
      <div class="flex justify-center w-full">
        <a href="/services" class="text-amber-800 mx-auto hover:underline mt-8 mb-14 inline-block">See More Services →</a>
      </div>
    {% endif %}
  </div>
</section>