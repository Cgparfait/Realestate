          </li>
            </ul> #}
          </div>
        {% endfor %}
        <!-- CTA -->
        <div class="mt-12 text-center col-span-full">
          <a href="/services" class="inline-flex items-center text-amber-600 hover:text-amber-700 font-medium">
        Explore All Solutions
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
        </div>
      {% else %}
        {% for service in services.slice(0, service_limit.length) %}
          <div class="bg-gray-50 p-6 rounded-lg shadow-sm border-l-4 border-amber-500 hover:shadow-md transition-shadow">
            <div class="flex items-center mb-4">
              <div class="bg-amber-500 w-12 h-12 rounded-full flex items-center justify-center text-white text-xl mr-4">
                <i class="fas fa-file-invoice-dollar"></i>
              </div>
              <h3 class="text-xl font-bold text-gray-800">{{ service.title }}</h3>
            </div>
            <p class="text-gray-600 text-sm mb-3">{{ service.description }}</p>
