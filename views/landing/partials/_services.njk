                <svg class="w-4 h-4 text-amber-500 mr-2 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
            Settle back taxes quickly
          </li>
            </ul> #}
          </div>
        {% endfor %}
      {% endif %}
    </div>

    {% if isLimited %}
      <div class="flex justify-center w-full">
        <a href="/services" class="text-amber-800 mx-auto hover:underline mt-8 mb-14 inline-block">See More Services →</a>
      </div>
    {% endif %}
