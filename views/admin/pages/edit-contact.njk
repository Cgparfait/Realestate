{% extends "../base.njk" %}
{% block content %}
  <main class="flex-1 overflow-y-auto p-6">
    <div class="max-w-4xl mx-auto">
      <!-- Page Header -->
      <div class="mb-8">
        <h2 class="text-xl font-bold">Edit Service</h2>
        <p class="text-gray-600">Update existing service details</p>
      </div>

      <!-- Form Card -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
        <form data-ajax-form action="/admin/contact/edit/" method="post" class="p-6">
          <input type="hidden" name="id" id="_id" value="{{id}}">

          <div class="space-y-6">

            <!-- Title Field -->
            <div class="form-group">
              <label for="phone" class="form-label">Phone number</label>
              <input id="phone" name="phone" rows="3" placeholder="Enter your phone number" class="form-input" value="{{phone}}">
            </div>

            <!-- Description Field -->
            <div class="form-group">
              <label for="email" class="form-label">Email Address</label>
              <input id="email" name="email" rows="5" placeholder="Enter your email" class="form-input" value="{{email}}">
            </div>

            <div class="form-group">
              <label for="address" class="form-label">Bussiness address</label>
              <input id="address" name="address" rows="5" placeholder="Enter your physical address" class="form-input" value="{{address}}">
            </div>

            <!-- Form Actions -->
            <div class="flex justify-end space-x-3 pt-4">
              <a href="/admin" class="px-6 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50 transition">
                    Cancel
                  </a>
              <button type="submit" class="btn-primary">
                    Save Changes
                  </button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </main>
{% endblock %}