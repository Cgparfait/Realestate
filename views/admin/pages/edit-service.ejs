<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Panel - Lioness Homes</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;700&display=swap');

    body {
      font-family: 'Montserrat', sans-serif;
    }

    .sidebar {
      height: 100vh;
      height: 100dvh;
      position: fixed;
      width: 16rem;
    }

    .main-content {
      margin-left: 16rem;
      width: calc(100% - 16rem);
    }

    .custom-select {
      appearance: none;
      background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%236b7280' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e");
      background-position: right 0.5rem center;
      background-repeat: no-repeat;
      background-size: 1.5em 1.5em;
    }

    @media (max-width: 768px) {
      .sidebar {
        transform: translateX(-100%);
      }

      .sidebar-open {
        transform: translateX(0);
      }

      .main-content {
        margin-left: 0;
        width: 100%;
      }
    }
  </style>
</head>

<body class="bg-gray-50 text-sm">
  <div class="flex min-h-screen">
    <!-- Sidebar -->
    <aside class="sidebar bg-gray-800 text-white z-20 transition-transform duration-200 ease-in-out flex flex-col">
      <!-- Sidebar Header -->
      <div class="p-6 border-b border-gray-700">
        <h1 class="text-xl font-bold tracking-tight">LIONESS HOMES</h1>
      </div>

      <!-- Sidebar Navigation -->
      <nav class="flex-1 overflow-y-auto p-4">
        <div class="space-y-1">
          <a href="/admin" class="flex items-center px-4 py-3 rounded hover:bg-gray-700 transition">
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
            Dashboard
          </a>

          <!-- Services Section -->
          <div class="mt-6">
            <p class="px-4 py-2 text-xs font-semibold text-gray-400 uppercase tracking-wider">Services</p>
            <div class="mt-1 space-y-1">
              <a href="/admin/service/create" class="flex items-center px-4 py-3 rounded hover:bg-gray-700 transition">
                <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                </svg>
                Create Service
              </a>
              <a href="/admin/service/edit" class="flex items-center px-4 py-3 rounded bg-gray-900 text-white transition">
                <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                </svg>
                Edit Services
              </a>
              <a href="/admin/service/delete" class="flex items-center px-4 py-3 rounded hover:bg-gray-700 transition">
                <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                </svg>
                Delete Service
              </a>
            </div>
          </div>

          <!-- Contact Section -->
          <div class="mt-6">
            <p class="px-4 py-2 text-xs font-semibold text-gray-400 uppercase tracking-wider">Contact</p>
            <div class="mt-1 space-y-1">
              <a href="/admin/contact/edit" class="flex items-center px-4 py-3 rounded hover:bg-gray-700 transition">
                <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
                Edit Contact Info
              </a>
            </div>
          </div>
        </div>
      </nav>

      <!-- Sidebar Footer -->
      <div class="p-4 border-t border-gray-700">
        <a href="/admin/logout" class="flex items-center px-4 py-3 rounded hover:bg-gray-700 transition">
          <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
          </svg>
          Logout
        </a>
      </div>
    </aside>

    <!-- Main Content -->
    <div class="main-content flex-1 flex flex-col">
      <!-- Top Navigation -->
      <header class="bg-white shadow-sm z-10 sticky top-0">
        <div class="flex items-center justify-between p-4">
          <button id="sidebar-toggle" class="md:hidden text-gray-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </button>
          <div class="flex items-center space-x-4">
            <div class="w-8 h-8 rounded-full bg-blue-600 flex items-center justify-center text-white font-medium">AD</div>
          </div>
        </div>
      </header>

      <!-- Page Content -->
      <main class="flex-1 overflow-y-auto p-6">
        <div class="max-w-4xl mx-auto">
          <!-- Page Header -->
          <div class="mb-8">
            <h2 class="text-xl font-bold text-gray-900">Edit Service</h2>
            <p class="text-gray-600">Update existing service details</p>
          </div>

          <!-- Form Card -->
          <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
            <form action="/admin/service/edit/" data-ajax-form method="post" class="p-6">
              <input type="hidden" name="id" id="_id">

              <div class="space-y-6">
                <!-- Service Selection -->
                <div class="space-y-2">
                  <label for="serviceSelect" class="block text-sm font-medium text-gray-700">Select Service to Edit</label>
                  <select id="serviceSelect" name="serviceSelect" class="custom-select w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition" required>
                    <option value="" disabled selected>Choose a service...</option>
                    <% services.forEach(service => { %>
                    <option value="<%= service._id %>"><%= service.title %></option>
                    <% }) %>
                  </select>
                </div>

                <!-- Title Field -->
                <div class="space-y-2">
                  <label for="titleInput" class="block text-sm font-medium text-gray-700">Service Title</label>
                  <textarea id="titleInput" name="title" rows="3" placeholder="Enter service title" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition" required></textarea>
                </div>

                <!-- Description Field -->
                <div class="space-y-2">
                  <label for="descriptionInput" class="block text-sm font-medium text-gray-700">Service Description</label>
                  <textarea id="descriptionInput" name="description" rows="5" placeholder="Enter detailed description" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition"></textarea>
                </div>

                <!-- Form Actions -->
                <div class="flex justify-end space-x-3 pt-4">
                  <a href="/admin" class="px-6 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition">
                    Cancel
                  </a>
                  <button type="submit" class="px-6 py-2 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition">
                    Save Changes
                  </button>
                </div>
              </div>
            </form>
          </div>
        </div>
      </main>
    </div>
  </div>

  <script>
    // Sidebar toggle for mobile
    document.getElementById('sidebar-toggle').addEventListener('click', () => {
      document.querySelector('.sidebar').classList.toggle('sidebar-open');
    });

    // Service selection handler
    const services = <%- JSON.stringify(services) %>;
    document.getElementById('serviceSelect').addEventListener('change', (e) => {
      const service = services.find(s => s._id === e.target.value);
      if (service) {
        document.getElementById('_id').value = service._id;
        document.getElementById('titleInput').value = service.title || '';
        document.getElementById('descriptionInput').value = service.description || '';
      }
    });

    // Close sidebar when clicking outside on mobile
    document.addEventListener('click', (e) => {
      const sidebar = document.querySelector('.sidebar');
      const sidebarToggle = document.getElementById('sidebar-toggle');

      if (window.innerWidth < 768 &&
        !sidebar.contains(e.target) &&
        e.target !== sidebarToggle &&
        !sidebarToggle.contains(e.target)) {
        sidebar.classList.remove('sidebar-open');
      }
    });
  </script>
  <script src="/js/handle-submit.js"></script>
</body>

</html>