<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Panel</title>
  <link rel="stylesheet" href="./css/admin-tailwind.css">
</head>

<body class="bg-gray-100">
  <div class="flex min-h-screen">
    <!-- Sidebar -->
    <div class="bg-gray-800 overflow-auto text-white w-64 space-y-6 py-7 px-2 fixed inset-y-0 left-0 transform -translate-x-full md:translate-x-0 transition duration-200 ease-in-out">
      <div class="text-white sticky -top-7 bg-gray-800 flex items-center -mt-7 -mx-2 p-6">
        <span class="text-2xl font-extrabold">Admin</span>
      </div>
      <nav>
        <a href="#" class="block py-2.5 px-4 rounded transition duration-200 hover:bg-gray-700">
          Dashboard
        </a>
        <a href="#" class="block py-2.5 px-4 rounded transition duration-200 hover:bg-gray-700">
          Services
        </a>
        <a href="#" onclick="toggleDropdown(this)" class="block py-2.5 px-4 rounded transition duration-200 hover:bg-gray-700">
          Contact info
        </a>
        <div class="ml-4 hidden">
          <a href="#" class="px-4 py-2.5 block transition duration-200 hover:bg-gray-700 rounded">Edit Contact</a>
        </div>
        <a href="#" onclick="toggleDropdown(this)" class="block py-2.5 px-4 rounded transition duration-200 hover:bg-gray-700">
          Settings
        </a>
        <div class="ml-4 hidden">
          <a href="#" class="px-4 py-2.5 block transition duration-200 hover:bg-gray-700 rounded">Edit Password</a>
          <a href="#" class="px-4 py-2.5 block transition duration-200 hover:bg-gray-700 rounded">Edit Username</a>
        </div>
      </nav>
    </div>


    <!-- Main Content -->
    <div class="flex-1 md:ml-64">
      <!-- Navbar -->
      <div class="bg-white shadow-md p-4">
        <div class="flex justify-between items-center">
          <div class="text-xl font-bold">Dashboard</div>
          <button class="md:hidden text-gray-500 focus:outline-none" onclick="toggleSidebar()">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
            </svg>
          </button>
        </div>
      </div>
      <!-- boddy -->
      <div class="p-8">
        <a href="" class="text-blue-800 block hover:underline py-2 border-b">Add Service</a>
        <a href="edit-service" class="text-blue-800 block hover:underline py-2 border-b">Edit Service</a>
        <a href="" class="text-blue-800 block hover:underline py-2 border-b">Manage Services</a>
      </div>
    </div>

    <!-- JavaScript to toggle sidebar on mobile -->
    <script src="/js/components/modal.js"></script>
    <script>
      function toggleSidebar() {
        const sidebar = document.querySelector('div[class*="transform -translate-x-full"]');
        sidebar.classList.toggle('translate-x-0');
      }

      function toggleDropdown(clickedElement) {
        clickedElement.nextElementSibling.classList.toggle('hidden')
      }
    </script>
    <!-- <script src="/js/requests/services-actions.js"></script> -->
    <script>
      const createService = async (event) => {
        event.preventDefault()

        const formData = new FormData(event.target)
        formDataObject = Object.fromEntries(formData.entries())

        try {
          const response = await fetch("/admin/service/create", {
            method: "PUT",
            headers: {
              "Content-Type": "application/json", // Important for JSON data
            },
            body: JSON.stringify(formDataObject)
          })

          if (response.ok) {
            const jsonResponse = await response.json()
            alert("Service has been created successfully")
            window.location.href = "/admin/"
            console.log(jsonResponse)
          }
        } catch (error) {
          alert("Failed to create service doe to an error in the system")
          console.log(error)
        }
      }

      const editService = async (event, id) => {
        event.preventDefault()

        const title = document.getElementById(id + "-title").innerText
        const description = document.getElementById(id + "-description").innerText

        console.log(title, description)

        try {
          const response = await fetch("/admin/service/edit/" + id, {
            method: "PATCH",
            headers: {
              "Content-Type": "application/json", // Important for JSON data
            },
            body: JSON.stringify({
              title: title,
              description: description
            })
          })

          if (response.ok) {
            const jsonResponse = await response.json()
            alert("Service has been updated successfully")
            window.location.href = "/admin/"
            console.log(jsonResponse)
          }
        } catch (error) {
          alert("Failed to update service doe to an error in the system")
          console.log(error)
        }
      }

      const deleteService = async (serviceId) => {
        if (confirm("are you sure you want to delete service" + serviceId)) {
          url = "/admin/service/delete/" + serviceId
          try {
            const response = await fetch(url, {
              method: "delete"
            })
            if (!response.ok) {
              alert("failed to delete service with id: " + serviceId)
            } else {
              const json_response = await response.json()
              alert(serviceId + " has been deleted successfully!")
              window.location.href = "/admin/"
            }
          } catch (error) {
            console.log("could not delete service fetch data for " + serviceId, error)
          }
        }
      }
    </script>
</body>

</html>