<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-100">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Panel</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/admin-tailwind.css">
  <style>
    .sidebar {
      height: 100vh;
      height: 100dvh;
      position: fixed;
      width: 16rem;
    }

    .sidebar-nav {
      height: calc(100% - 68px);
    }

    .main-content {
      margin-left: 16rem;
      width: calc(100% - 16rem);
    }

    .form-group {
      @apply flex flex-col space-y-2;
    }

    .form-label {
      @apply font-medium text-gray-800;
    }

    .form-input {
      @apply w-full px-4 py-2 border border-gray-300 rounded-md focus: outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition;
    }

    .btn-primary {
      @apply px-6 py-3 bg-blue-600 text-white font-medium rounded-md hover: bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition;
    }

    .dropdown-content {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease-out;
    }

    .dropdown-open {
      max-height: 500px;
    }

    @media (max-width: 768px) {
      .sidebar {
        transform: translateX(-100%);
      }

      .sidebar-open {
        transform: translateX(0);
      }

      .main-content {
        margin-left: 0;
        width: 100%;
      }
    }
  </style>
</head>

<body class="h-full">
  <div class="flex min-h-screen">
    <!-- Sidebar Component -->
    <aside id="sidebar" class="sidebar bg-gray-800 text-white z-20 transition-transform duration-200 ease-in-out flex flex-col">
      <!-- Sidebar Header -->
      <div class="p-6 border-b border-gray-700">
        <h1 class="text-2xl font-bold">Admin Panel</h1>
      </div>

      <!-- Sidebar Navigation -->
      <nav class="sidebar-nav overflow-y-auto p-4 flex flex-col">
        <div class="space-y-1 flex-1">
          <a href="#" class="block px-4 py-3 rounded hover:bg-gray-700 transition flex items-center">
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
            Dashboard
          </a>

          <!-- Services Dropdown -->
          <div class="dropdown-group">
            <a href="#" onclick="toggleDropdown(this)" class="block px-4 py-3 rounded hover:bg-gray-700 transition flex items-center">
              <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
              </svg>
              Services
              <svg class="ml-auto h-5 w-5 transition-transform" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </a>
            <div class="dropdown-content ml-8">
              <a href="/admin/service/create" class="block px-4 py-2 rounded hover:bg-gray-700 transition">Create Service</a>
              <a href="/admin/service/edit" class="block px-4 py-2 rounded hover:bg-gray-700 transition">Edit Services</a>
              <a href="/admin/service/delete" class="block px-4 py-2 rounded hover:bg-gray-700 transition">Delete Service</a>
            </div>
          </div>

          <!-- Contact Info Dropdown -->
          <div class="dropdown-group">
            <a href="#" onclick="toggleDropdown(this)" class="block px-4 py-3 rounded hover:bg-gray-700 transition flex items-center">
              <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
              Contact info
              <svg class="ml-auto h-5 w-5 transition-transform" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </a>
            <div class="dropdown-content ml-8">
              <a href="#" class="block px-4 py-2 rounded hover:bg-gray-700 transition">Edit Contact</a>
            </div>
          </div>

          <!-- Settings Dropdown -->
          <div class="dropdown-group">
            <a href="#" onclick="toggleDropdown(this)" class="block px-4 py-3 rounded hover:bg-gray-700 transition flex items-center">
              <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              Settings
              <svg class="ml-auto h-5 w-5 transition-transform" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </a>
            <div class="dropdown-content ml-8">
              <a href="#" class="block px-4 py-2 rounded hover:bg-gray-700 transition">Edit Password</a>
              <a href="#" class="block px-4 py-2 rounded hover:bg-gray-700 transition">Edit Username</a>
            </div>
          </div>
        </div>

        <!-- Sidebar Footer -->
        <div class="pt-4 border-t border-gray-700">
          <a href="#" class="block px-4 py-3 rounded hover:bg-gray-700 transition flex items-center">
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
            </svg>
            Logout
          </a>
        </div>
      </nav>
    </aside>

    <!-- Main Content Area -->
    <div class="main-content flex-1 flex flex-col overflow-hidden">
      <!-- Top Navigation Bar -->
      <header class="bg-white shadow-sm z-10">
        <div class="flex items-center justify-between p-4">
          <div class="flex items-center">
            <button id="sidebar-toggle" class="md:hidden text-gray-600 mr-4">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
              </svg>
            </button>
            <h2 class="text-xl font-bold">Service Management</h2>
          </div>
          <div class="flex items-center space-x-4">
            <button class="p-2 rounded-full hover:bg-gray-100">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
              </svg>
            </button>
            <div class="relative">
              <button class="flex items-center space-x-2 focus:outline-none">
                <div class="w-8 h-8 rounded-full bg-blue-500 flex items-center justify-center text-white font-medium">AD</div>
              </button>
            </div>
          </div>
        </div>
      </header>

      <!-- Scrollable Content -->
      <main class="flex-1 overflow-y-auto p-6 bg-gray-50">
        <div class="max-w-4xl mx-auto">
          <!-- Page Header -->
          <div class="mb-8">
            <h3 class="text-2xl font-bold text-gray-800">Delete Service</h3>
            <p class="text-gray-600">Delete one of the services from the list</p>
          </div>

          <!-- Form Card -->
          <div class="bg-white rounded-lg shadow-sm overflow-hidden">
            <form data-ajax-form action="/admin/service/delete/" method="post" class="p-6">
              <input type="hidden" name="id" id="_id">

              <div class="space-y-6">
                <!-- Service Selection -->
                <div class="form-group">
                  <label for="serviceSelect" class="form-label">Select Service to Edit</label>
                  <select id="serviceSelect" name="serviceSelect" class="form-input" required>
                    <option value="" disabled selected>Choose a service...</option>
                    <% services.forEach(service => { %>
                    <option value="<%= service.id %>"><%= service.title %></option>
                    <% }) %>
                  </select>
                </div>

                <!-- Form Actions -->
                <div class="flex justify-end space-x-3 pt-4">
                  <a href="/admin" class="px-6 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50 transition">
                    Cancel
                  </a>
                  <button type="submit" class="btn-primary">
                    Delete Service
                  </button>
                </div>
              </div>
            </form>
          </div>
        </div>
      </main>
    </div>
  </div>

  <script>
    // Sidebar toggle functionality
    document.getElementById('sidebar-toggle').addEventListener('click', () => {
      document.getElementById('sidebar').classList.toggle('sidebar-open');
    });

    // Service selection handler
    const services = <%- JSON.stringify(services) %>;
    document.getElementById('serviceSelect').addEventListener('change', (e) => {
      const service = services.find(s => s._id === e.target.value);
      if (service) {
        document.getElementById('_id').value = service._id;
        document.getElementById('titleInput').value = service.title;
        document.getElementById('descriptionInput').value = service.description;
      }
    });

    // Dropdown toggle function
    function toggleDropdown(element) {
      event.preventDefault();
      const dropdownGroup = element.parentElement;
      const dropdownContent = dropdownGroup.querySelector('.dropdown-content');
      const chevron = element.querySelector('svg:last-child');

      dropdownContent.classList.toggle('dropdown-open');
      chevron.classList.toggle('rotate-180');
    }

    // Close sidebar when clicking outside on mobile
    document.addEventListener('click', (e) => {
      const sidebar = document.getElementById('sidebar');
      const sidebarToggle = document.getElementById('sidebar-toggle');

      if (window.innerWidth < 768 &&
        !sidebar.contains(e.target) &&
        e.target !== sidebarToggle &&
        !sidebarToggle.contains(e.target)) {
        sidebar.classList.remove('sidebar-open');
      }
    });
  </script>
  <script src="/js/handle-submit.js"></script>
</body>

</html>